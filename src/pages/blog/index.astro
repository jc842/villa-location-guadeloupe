---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Toutes les Fiches et Guides de Location de Villas en Guadeloupe — Villa Location Guadeloupe">
  <section class="border-b border-teal-900/60 bg-[#061c1b] py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-950/40 px-3 py-1 text-xs text-teal-300 font-semibold mb-4">
        CATALOGUE DES GUIDES
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Toutes les Fiches & Guides de Villas en Guadeloupe</h1>
      <p class="mt-3 max-w-2xl text-slate-400 text-sm">
        Explorez nos sélections de villas avec piscine, conseils d'hébergement saisonnier et guides de secteurs à Saint-François, Sainte-Anne et Deshaies.
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#061c1b]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-teal-900/60 bg-[#082423]/50 p-6 hover:border-teal-500/50 transition-colors">
            <div>
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                <span class="rounded bg-teal-950 px-2 py-0.5 text-teal-300 font-semibold">{post.data.category || 'Guide'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h2 class="text-base font-bold text-white hover:text-teal-300 transition-colors line-clamp-2">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-teal-900/60 flex justify-end text-xs">
              <a href={'/blog/' + post.id + '/'} class="text-teal-400 hover:underline font-semibold">
                Lire le guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
