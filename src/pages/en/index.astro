---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-en');
---

<Layout title="Villa Location Guadeloupe — Luxury Villa Rentals with Private Pools in Guadeloupe" lang="en">
  <section class="border-b border-teal-900/60 bg-[#061c1b] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-950/40 px-3.5 py-1 text-xs text-teal-300 font-semibold mb-4">
        CARIBBEAN VILLA RENTALS
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Luxury Vacation Villas in Guadeloupe</h1>
      <p class="mt-4 max-w-2xl text-slate-300 text-sm sm:text-base leading-relaxed font-light">
        Private pool estates in Saint-François, beachfront residences in Sainte-Anne, and sunset hillside retreats in Deshaies.
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#061c1b]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-teal-900/60 bg-[#082423]/50 p-6 hover:border-teal-500/50 transition-colors">
            <div>
              <span class="rounded bg-teal-950 px-2 py-0.5 text-[11px] text-teal-300 font-semibold">{post.data.category}</span>
              <h2 class="text-lg font-bold text-white mt-3 hover:text-teal-300 transition-colors">
                <a href={'/en/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-teal-900/60 text-xs">
              <a href={'/en/' + post.id + '/'} class="text-teal-400 hover:underline font-semibold">Read Guide →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
